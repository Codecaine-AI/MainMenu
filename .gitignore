# OS/editor noise
.DS_Store
*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example

# Node dependencies and package-manager state
node_modules/
.pnpm-store/
.npm/
.yarn/
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# JavaScript/TypeScript build output and caches
.next/
**/.next/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
out/
dist/
dist-next/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Python environments, bytecode, and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Test, run, and temporary output
runs/
tmp/
temp/
test-results/
playwright-report/
blob-report/
*.log
logs/
apps/font-creation/font-studio/projects/*/outputs/
assets/
!apps/font-creation/generation/melee-3/inputs/assets/
!apps/font-creation/generation/melee-3/inputs/assets/**

# Scene Engine project payload belongs in external workspace repos.
apps/scene-engine/public/assets/
apps/scene-engine/public/modules/
apps/scene-engine/public/fonts/

!apps/scene-engine/app/api/assets/
!apps/scene-engine/app/api/assets/**
!apps/scene-engine/app/projects/\[projectId\]/assets/
!apps/scene-engine/app/projects/\[projectId\]/assets/**
!apps/scene-engine/app/projects/\[projectId\]/asset-workbench/assets/
!apps/scene-engine/app/projects/\[projectId\]/asset-workbench/assets/**

# Objective-local generated export bundles
objectives/*/artifacts/*.zip
objectives/*/artifacts/extracted/
objectives/*/artifacts/chrome-profile/

# Scene Engine local workspace catalog
apps/scene-engine/workspace.catalog.json

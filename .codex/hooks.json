{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/Ford/Github Repos/Codecaine/MELEE/.codex/hooks/core/auto-format.py'",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/Ford/Github Repos/Codecaine/MELEE/.codex/hooks/env/setup-env.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/Ford/Github Repos/Codecaine/MELEE/.codex/hooks/core/import-cleanup.py'",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}

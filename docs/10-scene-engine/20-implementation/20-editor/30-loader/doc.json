    "b-30-loader-usesceneloader-projecti-2": {
      "id": "b-30-loader-usesceneloader-projecti-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "useSceneLoader(projectId, sceneId)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the React hook the editor's "
        },
        {
          "insert": "page.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " calls during mount. It loads the merged registry, fetches the scene for the selected project, and seeds the store. It also exposes "
        },
        {
          "insert": "loading",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "error",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " flags so the shell can render placeholders."
        }
      ],
      "children": []
    },

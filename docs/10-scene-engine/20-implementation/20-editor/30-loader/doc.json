    "b-30-loader-a-loadcount-ref-tracks-10": {
      "id": "b-30-loader-a-loadcount-ref-tracks-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "loadCount",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ref tracks the active load. If "
        },
        {
          "insert": "sceneId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " changes mid-fetch, the in-flight callback compares "
        },
        {
          "insert": "thisLoad === loadCount.current",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " before writing to the store, so a stale response can't overwrite a fresher one."
        }
      ],
      "children": []
    },

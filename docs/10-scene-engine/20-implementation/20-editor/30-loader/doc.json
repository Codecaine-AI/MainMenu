    "b-30-loader-after-the-scene-and-regi-12": {
      "id": "b-30-loader-after-the-scene-and-regi-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "After the scene and registry are loaded, "
        },
        {
          "insert": "useSceneLoader",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " scans the scene for "
        },
        {
          "insert": "component",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "-type layers, resolves each component's module path from the registry, and calls "
        },
        {
          "insert": "loadComponentSchema(modulePath)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This function (in "
        },
        {
          "insert": "app/_engine/lib/component-schema-loader.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") fetches the component's "
        },
        {
          "insert": ".js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " file, imports it via a Blob URL shim, reads the module's "
        },
        {
          "insert": "properties",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " export, validates its shape ("
        },
        {
          "insert": "{ sections: [...] }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), and caches the result. The resolved schemas are written into the Zustand store's "
        },
        {
          "insert": "componentSchemas",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " map keyed by asset ID."
        }
      ],
      "children": []
    },
    "b-30-loader-schema-loading-is-asynch-13": {
      "id": "b-30-loader-schema-loading-is-asynch-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Schema loading is asynchronous. Until a component's schema arrives, the inspector renders that component's properties under the General fallback section. In practice the loading window is short: the editor already waits for the scene + registry fetch, and component modules are small."
        }
      ],
      "children": []
    },
    "b-30-loader-the-blob-url-import-tric-14": {
      "id": "b-30-loader-the-blob-url-import-tric-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Blob URL import trick mirrors what the production renderer already does for component modules, so there is no new import mechanism."
        }
      ],
      "children": []

    "b-30-loader-load-the-registry-firs-5": {
      "id": "b-30-loader-load-the-registry-firs-5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Load the registry first.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Dynamic-import "
        },
        {
          "insert": "asset-registry.js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (browser-only, since it caches in module scope), set "
        },
        {
          "insert": "window.MELEE_PROJECT_ID",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when a project id is active, and call "
        },
        {
          "insert": "loadRegistry({ projectId })",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It fetches the selected project's asset, module, and font registries through project-aware dev routes and enriches each module entry with its "
        },
        {
          "insert": "manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Then "
        },
        {
          "insert": "setRegistry(getRegistry())",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-30-loader-fetch-the-scene-ge-6": {
      "id": "b-30-loader-fetch-the-scene-ge-6",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Fetch the scene.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "GET /api/scenes/<id>?project=<project-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "cache: 'no-store'",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " so reload always hits disk. Throw on non-OK."
        }
      ],
      "children": []
    },

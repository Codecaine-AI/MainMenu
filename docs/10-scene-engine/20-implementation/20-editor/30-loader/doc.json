    "b-30-loader-the-add-layer-dialog-and-16": {
      "id": "b-30-loader-the-add-layer-dialog-and-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The add-layer dialog and the inspector both need the registry to render meaningful UI (asset names, manifest fields, asset-selection dropdowns). Loading the registry before the scene means the very first paint can render a populated inspector when the scene also arrives, instead of flashing through an \"asset unknown\" state."
        }

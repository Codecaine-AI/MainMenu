    "b-00-overview-code-9": {
      "id": "b-00-overview-code-9",
      "type": "code",
      "props": {},
      "text": [
        {
          "insert": "workspace catalog → project root/Assets/Scenes/<scene>/scene.json ── fetched ──> renderer ── DOM ──> stage\n   ▲\n   │ writes\n   ├── visual editor (browser) ── PUT /api/scenes/{id}?project={project} ── Next route\n   │\n   └── Pi Agent / file edits (desktop-owned SDK session)"
        }
      ],
      "children": []
    },
    "b-00-overview-mermaid-10": {
      "id": "b-00-overview-mermaid-10",
      "type": "code",
      "props": {
        "language": "mermaid"
      },
      "text": [
        {
          "insert": "graph TD\n    SJ[scene.json files]\n    AR[project registries]\n    RND[Renderer app/_engine/renderer]\n    ED[Visual editor app/editor]\n    API[Next route handlers app/api]\n    DESK[Main Menu desktop shell]\n    AGT[Pi Agent / file edits]\n    DOM[Rendered DOM stage]\n    ZIP[Standalone export zip]\n\n    SJ --> RND\n    AR --> RND\n    RND --> DOM\n    SJ --> ED\n    AR --> ED\n    ED -->|PUT| API\n    API -->|writes| SJ\n    DESK -->|loads| ED\n    DESK -->|IPC| AGT\n    AGT -->|file write| SJ\n    AGT -->|PUT| API\n    SJ --> ZIP\n    AR --> ZIP\n    RND --> ZIP"
        }
      ],
      "children": []
    },

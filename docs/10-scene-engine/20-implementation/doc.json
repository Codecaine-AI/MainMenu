    "b-00-overview-think-of-scene-json-as-5": {
      "id": "b-00-overview-think-of-scene-json-as-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Think of "
        },
        {
          "insert": "scene.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as the document and the renderer as a print engine. The editor and the agent are two different word processors that edit the document. The print engine doesn't care which produced the document; it only cares the document is valid."
        }
      ],
      "children": []
    },
    "b-00-overview-the-renderer-itself-has-6": {
      "id": "b-00-overview-the-renderer-itself-has-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The renderer itself has no framework or virtual DOM. It dispatches by string "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to small renderer functions. React owns the page/editor shells, while Zustand owns editor state and mutations."
        }
      ],
      "children": []
    },

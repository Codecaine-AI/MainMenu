    "b-00-overview-the-scene-engine-is-a-ne-2": {
      "id": "b-00-overview-the-scene-engine-is-a-ne-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scene-engine is a Next.js app under "
        },
        {
          "insert": "apps/scene-engine/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It has four coordinated subsystems: a "
        },
        {
          "insert": "plain-JS production renderer",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", a "
        },
        {
          "insert": "React/Zustand visual editor",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Next route handlers",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " for scene, asset, registry, font, and export operations, and the "
        },
        {
          "insert": "Main Menu Electron shell",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " for desktop authoring, all operating on project-local "
        },
        {
          "insert": "scene.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " files and registries discovered through a workspace catalog."
        }
      ],
      "children": []
    },

    },
    "b-20-asset-registry-an-id-that-appears-in-bo-9": {
      "id": "b-20-asset-registry-an-id-that-appears-in-bo-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An ID that appears in both manifests is logged as a collision and the "
        },
        {
          "insert": "module entry wins",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". This is treated as a misconfiguration rather than a feature."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-renderer-cannot-tell-10": {
      "id": "b-20-asset-registry-the-renderer-cannot-tell-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The renderer cannot tell which manifest an entry came from after the merge. That's intentional. Layer dispatch is by "
        },
        {
          "insert": "layer.type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the entry only needs to expose a "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and a fetchable file pointer ("
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for assets, "
        },
        {
          "insert": "path",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for modules)."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-state-11": {

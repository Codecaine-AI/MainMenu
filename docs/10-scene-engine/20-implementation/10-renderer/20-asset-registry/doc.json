    },
    "b-20-asset-registry-a-scene-with-one-missing-18": {
      "id": "b-20-asset-registry-a-scene-with-one-missing-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A scene with one missing container should still render the rest of the scene. Throwing on "
        },
        {
          "insert": "resolveAsset",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " would let one bad ID wipe out the whole stage. Returning "
        },
        {
          "insert": "null",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lets "
        },
        {
          "insert": "scene-renderer.js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "console.warn",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and skip that layer."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-programmer-errors-that-19": {
      "id": "b-20-asset-registry-programmer-errors-that-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Programmer errors that "
        },
        {
          "insert": "should",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " be loud, like an unregistered renderer type, do throw, in the asset-renderers index, not here."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-why-an-empty-object-on-f-20": {
      "id": "b-20-asset-registry-why-an-empty-object-on-f-20",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [

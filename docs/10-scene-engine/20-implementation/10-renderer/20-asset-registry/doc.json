    "b-20-asset-registry-apps-scene-engine-app-2": {
      "id": "b-20-asset-registry-apps-scene-engine-app-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "apps/scene-engine/app/_engine/renderer/asset-registry.js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " loads the active project's asset, module, and font registries, merges them into a single module-level map, and answers ID lookups synchronously after that. It deliberately does not throw on misses. See the rationale in "
        },
        {
          "insert": "System Design / Rendering Pipeline / Failure Modes",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-scene-engine/10-system-design/30-rendering-pipeline",
              "section": "failure-modes",
              "label": "System Design / Rendering Pipeline / Failure Modes"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },

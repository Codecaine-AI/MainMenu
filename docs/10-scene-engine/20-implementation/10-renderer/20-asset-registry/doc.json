    "b-20-asset-registry-the-normal-dev-path-is-p-16": {
      "id": "b-20-asset-registry-the-normal-dev-path-is-p-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The normal dev path is project-aware: "
        },
        {
          "insert": "/api/projects/<project-id>/registries/assets",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "/modules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "/fonts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Export bundles use "
        },
        {
          "insert": "/assets/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "/modules/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "/fonts/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolved through "
        },
        {
          "insert": "MELEE_BUNDLE_ROOT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Outside an export bundle, callers must provide a project id."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-why-lookups-don-t-throw-17": {
      "id": "b-20-asset-registry-why-lookups-don-t-throw-17",
      "type": "heading",

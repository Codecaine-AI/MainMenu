      "id": "b-20-asset-registry-the-selected-manifest-ur-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The selected manifest URLs are fetched in parallel. The merge starts with font entries and asset entries, then adds every module entry on top:"
        }
      ],
      "children": []
    },
    "b-20-asset-registry-disjoint-ids-the-normal-8": {
      "id": "b-20-asset-registry-disjoint-ids-the-normal-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Disjoint IDs (the normal case) end up in one flat map."
        }

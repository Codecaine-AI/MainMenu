        }
      ],
      "children": []
    },
    "b-20-asset-registry-fetchmanifest-catches-21": {
      "id": "b-20-asset-registry-fetchmanifest-catches-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "fetchManifest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " catches network/parse errors and returns "
        },
        {
          "insert": "{}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for that manifest. The merge proceeds with whatever did load. This means a missing "
        },
        {
          "insert": "modules/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " doesn't take down asset rendering, and a missing "
        },
        {
          "insert": "assets/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " doesn't take down modules. Subsequent lookups warn but don't retry: avoids a thundering herd of failed fetches in a broken dev session."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-optional-cache-mutation-22": {
      "id": "b-20-asset-registry-optional-cache-mutation-22",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Optional Cache Mutation"
        }
      ],
      "children": []
    },
    "b-20-asset-registry-updateentry-is-the-in-23": {
      "id": "b-20-asset-registry-updateentry-is-the-in-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "updateEntry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the in-memory side of direct registry-patch maintenance flows. The current inspector asset dropdown changes scene "
        },
        {
          "insert": "asset",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " references, so it does not call "
        },
        {
          "insert": "updateEntry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-if-a-caller-patches-ap-24": {
      "id": "b-20-asset-registry-if-a-caller-patches-ap-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If a caller PATCHes "
        },
        {
          "insert": "/api/registry/{id}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " while the editor is open, it can call "
        },
        {
          "insert": "updateEntry(id, { file })",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " after the server responds to keep the renderer cache aligned without a page reload."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-without-that-explicit-ca-25": {
      "id": "b-20-asset-registry-without-that-explicit-ca-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Without that explicit cache update, the next render uses the registry snapshot loaded at scene boot."
        }
      ],
      "children": []

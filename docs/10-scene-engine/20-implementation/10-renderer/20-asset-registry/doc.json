    },
    "b-20-asset-registry-export-5-tbl": {
      "id": "b-20-asset-registry-export-5-tbl",
      "type": "structured-table",
      "props": {
        "columns": [
          "Export",
          "Behavior"
        ],
        "rows": [
          [
            [
              {
                "insert": "loadRegistry({ projectId? })",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Async. Resolves registry URLs for an export bundle or a catalog-backed project dev route. Fetches asset/module/font registries in parallel, merges into one map, and caches by registry key. Concurrent calls for the same key share one in-flight promise."
          ],
          [
            [
              {
                "insert": "resolveAsset(id)",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Sync. Returns the merged entry for "
              },
              {
                "insert": "id",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", or "
              },
              {
                "insert": "null",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " (with warning) if "
              },
              {
                "insert": "loadRegistry",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " hasn't completed or the ID is unknown."
              }
            ]
          ],
          [
            [
              {
                "insert": "getRegistry()",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Sync. Returns the full merged map, or "
              },
              {
                "insert": "null",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " if not loaded. Used by the editor's add-layer dialog and inspector."
              }
            ]
          ],
          [
            [
              {
                "insert": "updateEntry(id, partial)",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Sync. Shallow-merges "
              },
              {
                "insert": "partial",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " into the active in-memory entry. Kept for maintenance flows that patch a registry entry during an active session."
              }
            ]
          ]
        ]
      },
      "children": []
    },

            "bold": true
          }
        },
        {
          "insert": " (to render property fields) and for "
        },
        {
          "insert": "defaulting",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " (when a new object is added, the editor seeds "
        },
        {
          "insert": "properties",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the manifest's "
        },
        {
          "insert": "default",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " values). See the "
        },
        {
          "insert": "component-manifest design doc",
          "attributes": {

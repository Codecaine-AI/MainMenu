    "b-30-principles-a-general-purpose-webs-29": {
      "id": "b-30-principles-a-general-purpose-webs-29",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A general-purpose website builder.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Built for one author, with one taste."
        }
      ],
      "children": []
    },
    "b-30-principles-scene-to-scene-transit-30": {

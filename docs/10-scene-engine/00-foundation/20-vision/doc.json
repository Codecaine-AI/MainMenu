    "b-20-vision-no-surface-is-the-source-22": {
      "id": "b-20-vision-no-surface-is-the-source-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "No surface is the source of truth. Project files are. The pattern was proven at the glyph level by the font app's "
        },
        {
          "insert": "layer-recipe.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The scene-engine generalizes it to whole-page compositions and project workspaces."
        }

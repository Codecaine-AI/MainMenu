    "b-20-vision-scenes-build-to-a-mult-33": {
      "id": "b-20-vision-scenes-build-to-a-mult-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Scenes build to a "
        },
        {
          "insert": "multi-page web app",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " bundled with only the active media/modules/fonts required by the exported scenes. Each scene becomes one page in the built output. Not a single-file export (videos can't be inlined). Not a live-rendered CMS (scenes are authored, then built)."
        }
      ],
      "children": []

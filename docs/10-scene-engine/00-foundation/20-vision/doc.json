    "b-20-vision-layers-form-a-tree-12": {
      "id": "b-20-vision-layers-form-a-tree-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Layers form a "
        },
        {
          "insert": "tree",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Most layers are leaves. Some are "
        },
        {
          "insert": "groups",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " (e.g. the Codecaine logo, which is itself a stack of ~30 SVG sub-layers)."
        }
      ],
      "children": []
    },

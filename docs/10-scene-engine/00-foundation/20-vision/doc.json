      "id": "b-20-vision-the-engine-treats-upload-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The engine treats uploadable files and authored modules as separate registry entries because they are created and maintained differently:"
        }
      ],
      "children": []

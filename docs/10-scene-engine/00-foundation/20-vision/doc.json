    "b-20-vision-foreign-assets-can-int-15": {
      "id": "b-20-vision-foreign-assets-can-int-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Foreign assets can interleave between a group's sub-layers",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": for example, placing a fire-video texture between the chrome extrusion shadow and the chrome face of the logo. This is what lets z-depth be expressive at fine granularity."
        }
      ],
      "children": []
    },
    "b-20-vision-z-order-is-array-positio-16": {

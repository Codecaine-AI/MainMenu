      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every new combination of these into a stage requires writing rendering wiring from scratch, even though the rendering logic for \"show this video full-stage,\" \"show this CSS effect on top,\" \"place this glyph centered top-third\" repeats every time."
        }
      ],
      "children": []

    "b-10-problem-the-user-s-iterative-wor-15": {
      "id": "b-10-problem-the-user-s-iterative-wor-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The user's iterative work is on "
        },
        {
          "insert": "composition",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": figuring out layer order, blend modes, normal mappings, where to interleave a video texture between two glyph sub-layers, not on rendering plumbing. The hand-wired model keeps reintroducing rendering plumbing as a tax on every composition decision."
        }
      ],
      "children": []
    },

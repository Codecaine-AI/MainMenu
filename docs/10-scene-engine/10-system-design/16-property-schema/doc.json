    "b-16-property-schema-properties-render-in-dec-17": {
      "id": "b-16-property-schema-properties-render-in-dec-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Properties render in declaration order within their section. The author controls the reading flow."
        }
      ],
      "children": []
    },
    "b-16-property-schema-the-editor-treats-defau-18": {
      "id": "b-16-property-schema-the-editor-treats-defau-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The editor treats "
        },
        {
          "insert": "default",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as a display/editing fallback only. It does not write default values into scene JSON until the user changes a field. Runtime components should still keep their own defensive fallbacks because exported or older scenes may omit properties."
        }
      ],
      "children": []
    },

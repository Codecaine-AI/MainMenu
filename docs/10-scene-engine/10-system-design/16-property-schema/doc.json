    "b-16-property-schema-component-schemas-are-co-27": {
      "id": "b-16-property-schema-component-schemas-are-co-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Component schemas are co-located with the code they describe: one file to read, one file to edit. Built-in schemas are centralized because those layer types have no authored module to attach to."
        }
      ],
      "children": []
    },
    "b-16-property-schema-always-sectioned-model-28": {
      "id": "b-16-property-schema-always-sectioned-model-28",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Always-Sectioned Model"
        }
      ],
      "children": []
    },
    "b-16-property-schema-every-schema-is-a-list-o-29": {
      "id": "b-16-property-schema-every-schema-is-a-list-o-29",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every schema is a list of sections. There is no \"flat mode.\" Even a layer with a single group of properties renders under one named section. This means:"
        }
      ],
      "children": []
    },
    "b-16-property-schema-one-rendering-path-in-th-30": {
      "id": "b-16-property-schema-one-rendering-path-in-th-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "One rendering path in the inspector. No branching between flat and sectioned layouts."
        }
      ],
      "children": []
    },
    "b-16-property-schema-authors-start-with-minim-31": {
      "id": "b-16-property-schema-authors-start-with-minim-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Authors start with minimal ceremony (one section named \"General\" or after the layer type)."
        }
      ],
      "children": []
    },
    "b-16-property-schema-adding-sections-later-is-32": {
      "id": "b-16-property-schema-adding-sections-later-is-32",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Adding sections later is purely additive: no structural migration."
        }
      ],
      "children": []
    },
    "b-16-property-schema-section-collapsibility-33": {
      "id": "b-16-property-schema-section-collapsibility-33",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Section Collapsibility"
        }
      ],
      "children": []
    },
    "b-16-property-schema-every-schema-section-can-34": {
      "id": "b-16-property-schema-every-schema-section-can-34",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every schema section can declare whether it collapses and whether it starts open:"
        }
      ],
      "children": []
    },
    "b-16-property-schema-collapsible-true-make-35": {
      "id": "b-16-property-schema-collapsible-true-make-35",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "collapsible: true",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " makes a section header toggle its body."
        }
      ],
      "children": []
    },
    "b-16-property-schema-collapsible-false-pin-36": {
      "id": "b-16-property-schema-collapsible-false-pin-36",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "collapsible: false",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pins the section open, even for nested sections."
        }
      ],
      "children": []
    },
    "b-16-property-schema-defaultopen-false-sta-37": {
      "id": "b-16-property-schema-defaultopen-false-sta-37",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "defaultOpen: false",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts a section collapsed. On top-level sections, this also opts the section into collapse behavior."
        }
      ],
      "children": []
    },
    "b-16-property-schema-defaultopen-true-star-38": {
      "id": "b-16-property-schema-defaultopen-true-star-38",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "defaultOpen: true",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts a collapsible section expanded."
        }
      ],
      "children": []
    },
    "b-16-property-schema-top-level-sections-are-o-39": {
      "id": "b-16-property-schema-top-level-sections-are-o-39",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Top-level sections are open by default. Nested sections are collapsible and closed by default unless the schema says otherwise. Use nesting for meaningful ownership boundaries: for example, a broad \"Motion\" section can contain \"Selection\", \"Layer Changes\", and \"Title Prism\" subsections. Avoid using nesting only to hide unrelated settings. If a group needs to collapse, it should still live under the parent concept that owns it."
        }
      ],
      "children": []
    },
    "b-16-property-schema-the-general-fallback-40": {
      "id": "b-16-property-schema-the-general-fallback-40",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The General Fallback"
        }
      ],
      "children": []
    },
    "b-16-property-schema-when-a-layer-has-no-decl-41": {
      "id": "b-16-property-schema-when-a-layer-has-no-decl-41",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When a layer has no declared schema (or a component whose schema hasn't loaded yet), all of its saved properties render under an auto-generated "
        },
        {
          "insert": "General",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " section. This ensures every layer is editable immediately."
        }
      ],
      "children": []
    },
    "b-16-property-schema-properties-that-exist-in-42": {
      "id": "b-16-property-schema-properties-that-exist-in-42",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Properties that exist in the saved data but are absent from the declared schema, "
        },
        {
          "insert": "orphans",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", also render under General. The system infers an input type from the value's runtime type (number → slider, boolean → toggle, color-like string → color field, other string → text). A developer warning names the orphan and the schema source, so renames and removals don't go unnoticed."
        }
      ],
      "children": []
    },
    "b-16-property-schema-description-popovers-43": {
      "id": "b-16-property-schema-description-popovers-43",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Description Popovers"
        }
      ],
      "children": []
    },
    "b-16-property-schema-each-property-label-is-a-44": {
      "id": "b-16-property-schema-each-property-label-is-a-44",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each property label is a click target. Clicking it opens a small floating popover anchored next to the label, showing the property's full label and description. Clicking outside or pressing Escape dismisses it. Section labels with a description behave the same way. Sections without a description render a non-clickable header."
        }
      ],
      "children": []
    },
    "b-16-property-schema-this-is-an-explicit-cl-45": {
      "id": "b-16-property-schema-this-is-an-explicit-cl-45",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is an "
        },
        {
          "insert": "explicit click affordance",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", not a hover tooltip. With many properties per inspector, hover tooltips create visual noise. The explicit popup lets the author seek information deliberately."
        }
      ],
      "children": []
    },
    "b-16-property-schema-sub-layer-participation-46": {
      "id": "b-16-property-schema-sub-layer-participation-46",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Sub-Layer Participation"
        }
      ],
      "children": []
    },
    "b-16-property-schema-sub-layer-editing-contex-47": {
      "id": "b-16-property-schema-sub-layer-editing-contex-47",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sub-layer editing contexts (named SVG sub-layers and foreign media children nested inside glyph-groups) participate in the same sectioned schema rendering. Their schemas come from the same sources the parent uses. The editing experience is uniform regardless of nesting depth."
        }
      ],
      "children": []
    },
    "b-16-property-schema-relationship-to-the-mani-48": {
      "id": "b-16-property-schema-relationship-to-the-mani-48",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Relationship to the Manifest Convention"
        }
      ],
      "children": []
    },
    "b-16-property-schema-the-property-schema-syst-49": {
      "id": "b-16-property-schema-the-property-schema-syst-49",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The property schema system is separate from the "
        },
        {
          "insert": "manifest convention",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-scene-engine/10-system-design/15-component-manifest",
              "label": "manifest convention"
            }
          }
        },
        {
          "insert": ". Manifests ("
        },
        {
          "insert": "manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") still declare module-level metadata (name, type, sizing hint) and are used by effects for property fields. For all other layer types, the property schema is the authoritative source of property structure and labels in the inspector."
        }
      ],
      "children": []
    },
    "b-16-property-schema-see-authoring-surfaces-50": {
      "id": "b-16-property-schema-see-authoring-surfaces-50",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "See "
        },
        {
          "insert": "Authoring Surfaces",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-scene-engine/10-system-design/40-authoring-surfaces",
              "label": "Authoring Surfaces"
            }
          }
        },
        {
          "insert": " for how schemas integrate into the inspector's section layout."
        }
      ],
      "children": []
    }

    "b-16-property-schema-every-layer-type-can-dec-2": {
      "id": "b-16-property-schema-every-layer-type-can-dec-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every layer type can declare a "
        },
        {
          "insert": "property schema",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " that structures its editable properties into named sections, attaches human-readable labels and descriptions, and locks each property to one of a fixed set of input types. The inspector renders by schema. Authors control grouping, ordering, and documentation of every field."
        }
      ],
      "children": []
    },
    "b-16-property-schema-divider-3": {
      "id": "b-16-property-schema-divider-3",
      "type": "divider",
      "props": {},
      "children": []
    },
    "b-16-property-schema-why-schemas-exist-4": {
      "id": "b-16-property-schema-why-schemas-exist-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why Schemas Exist"
        }
      ],
      "children": []
    },
    "b-16-property-schema-components-and-other-lay-5": {
      "id": "b-16-property-schema-components-and-other-lay-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Components and other layer types can accumulate many properties with terse or technical names. A flat list of unlabeled fields forces the author to know what every key does. Property schemas solve three problems:"
        }
      ],
      "children": []
    },
    "b-16-property-schema-grouping-related-p-6": {
      "id": "b-16-property-schema-grouping-related-p-6",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Grouping",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Related properties appear under named sections (e.g., \"Rotation\", \"3D Position\")."
        }
      ],
      "children": []
    },
    "b-16-property-schema-meaning-each-prope-7": {
      "id": "b-16-property-schema-meaning-each-prope-7",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Meaning",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Each property carries a label (human name) and an optional description (what it does)."
        }
      ],
      "children": []
    },
    "b-16-property-schema-input-type-the-sch-8": {
      "id": "b-16-property-schema-input-type-the-sch-8",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Input type",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". The schema declares what kind of editor control renders for each property."
        }
      ],
      "children": []
    },
    "b-16-property-schema-schema-shape-9": {
      "id": "b-16-property-schema-schema-shape-9",

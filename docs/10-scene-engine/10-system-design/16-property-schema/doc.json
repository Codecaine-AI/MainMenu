    "b-16-property-schema-a-schema-is-an-ordered-l-10": {
      "id": "b-16-property-schema-a-schema-is-an-ordered-l-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A schema is an ordered list of "
        },
        {
          "insert": "sections",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Each section has an identifier, a display label, an optional description, optional collapse behavior, and an ordered map of "
        },
        {
          "insert": "property definitions",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Sections can nest: a section may contain child sections in addition to properties."
        }
      ],
      "children": []
    },
    "b-16-property-schema-a-property-definition-de-11": {
      "id": "b-16-property-schema-a-property-definition-de-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A property definition declares:"
        }
      ],
      "children": []
    },

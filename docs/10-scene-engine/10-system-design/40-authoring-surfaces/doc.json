    "b-40-authoring-surfaces-in-the-desktop-app-the-44": {
      "id": "b-40-authoring-surfaces-in-the-desktop-app-the-44",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "In the desktop app, the Pi Agent starts from a bottom-left sidebar chat panel. Each request includes the active project id, scene id, selected layer path, selected layer name, and selected layer type. The renderer only talks to "
        },
        {
          "insert": "window.mainMenu.agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The native process owns the SDK session, session directory, abort/reset controls, and working-directory selection."
        }
      ],
      "children": []
    },
    "b-40-authoring-surfaces-the-agent-does-not-subsc-45": {
      "id": "b-40-authoring-surfaces-the-agent-does-not-subsc-45",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The agent does not subscribe to live scene updates. It edits, the human reloads the editor or page to see the change. Symmetrically, after the human saves, the agent re-reads the file on its next pass."
        }
      ],
      "children": []
    },
    "b-40-authoring-surfaces-the-canonical-object-sha-46": {
      "id": "b-40-authoring-surfaces-the-canonical-object-sha-46",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical object shape is the same on both sides. An agent writing a new object follows the same rules as the editor's add-object defaults."
        }
      ],
      "children": []
    },
    "b-40-authoring-surfaces-why-reload-based-handoff-47": {

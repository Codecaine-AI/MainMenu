        }
      ],
      "children": []
    },
    "b-60-asset-uploads-when-an-asset-type-layer-24": {
      "id": "b-60-asset-uploads-when-an-asset-type-layer-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When an asset-type layer is selected in the editor, the inspector shows project-available containers of that same type from "
        },
        {
          "insert": "/api/asset-library?project=<project-id>&type=<type>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Picking a different entry:"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-mutates-the-selected-sce-25": {
      "id": "b-60-asset-uploads-mutates-the-selected-sce-25",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Mutates the selected scene object or slot from "
        },
        {
          "insert": "asset: oldId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "asset: newId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-marks-the-editor-dirty-26": {
      "id": "b-60-asset-uploads-marks-the-editor-dirty-26",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Marks the editor dirty; Save writes the scene through "
        },
        {
          "insert": "PUT /api/scenes/<id>?project=<project-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-leaves-registry-entries-27": {
      "id": "b-60-asset-uploads-leaves-registry-entries-27",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Leaves registry entries untouched. Containers remain stable inventory records; scenes decide which container they use."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-this-is-selection-by-id-28": {
      "id": "b-60-asset-uploads-this-is-selection-by-id-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is selection by ID, not a registry file-pointer mutation. Other scenes that reference the old container are unaffected."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-why-a-dropdown-rather-th-29": {
      "id": "b-60-asset-uploads-why-a-dropdown-rather-th-29",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Why a dropdown rather than inline upload"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-upload-and-selection-are-30": {
      "id": "b-60-asset-uploads-upload-and-selection-are-30",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Upload and selection are separate concerns. The inspector is for arranging containers in a scene; introducing an upload form there would couple authoring with file management. The dropdown is the smallest UI that supports the container indirection: point the layer at a different registered container without leaving the scene."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-if-the-desired-file-isn-31": {
      "id": "b-60-asset-uploads-if-the-desired-file-isn-31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the desired file isn't yet in the project, the path is: go to "
        },
        {
          "insert": "/upload?project=<project-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", upload it, come back, pick the new container from the dropdown."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-what-this-buys-32": {
      "id": "b-60-asset-uploads-what-this-buys-32",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What This Buys"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-authoring-without-file-33": {
      "id": "b-60-asset-uploads-authoring-without-file-33",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Authoring without filesystem access.",

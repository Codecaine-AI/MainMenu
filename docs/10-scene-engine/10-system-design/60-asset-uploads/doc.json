    "b-60-asset-uploads-there-are-two-ways-a-fil-2": {
      "id": "b-60-asset-uploads-there-are-two-ways-a-fil-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There are two ways a file enters or moves through the system:"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-upload-a-new-file-3": {
      "id": "b-60-asset-uploads-upload-a-new-file-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Upload",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". A new file lands on disk and a new container is registered for it."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-selection-a-scene-4": {
      "id": "b-60-asset-uploads-selection-a-scene-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Selection",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". A scene layer or glyph slot is pointed at a different existing container of the same asset type."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-both-flows-are-scoped-to-5": {
      "id": "b-60-asset-uploads-both-flows-are-scoped-to-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Both flows are scoped to the five file asset types ("
        },
        {
          "insert": "audio",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "image",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "video",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "glyph",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "font",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Modules don't participate: they're hand-authored, not uploaded."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-divider-6": {
      "id": "b-60-asset-uploads-divider-6",
      "type": "divider",
      "props": {},
      "children": []
    },
    "b-60-asset-uploads-upload-flow-7": {
      "id": "b-60-asset-uploads-upload-flow-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Upload Flow"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-upload-is-a-standalone-s-8": {
      "id": "b-60-asset-uploads-upload-is-a-standalone-s-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Upload is a standalone surface ("
        },
        {
          "insert": "/upload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), separate from the editor. A user with no filesystem access can add an asset without opening a scene."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-code-9": {
      "id": "b-60-asset-uploads-code-9",
      "type": "code",
      "props": {},
      "text": [
        {
          "insert": "file picked → type pre-filled from mime → user confirms → POST → server validates → write file → register container"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-step-by-step-10": {
      "id": "b-60-asset-uploads-step-by-step-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Step by step:"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-pick-a-file-any-fil-11": {
      "id": "b-60-asset-uploads-pick-a-file-any-fil-11",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Pick a file.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Any file the OS will give the browser."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-pre-fill-the-type-t-12": {
      "id": "b-60-asset-uploads-pre-fill-the-type-t-12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Pre-fill the type.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The page inspects the file's mime and suggests a type if it matches one allowlist (e.g. "
        },
        {
          "insert": "video/mp4",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " → "
        },
        {
          "insert": "video",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). The user can override."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-confirm-and-submit-13": {
      "id": "b-60-asset-uploads-confirm-and-submit-13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Confirm and submit.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Multipart POST to the upload endpoint with the file and the chosen type."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-server-validates-bo-14": {
      "id": "b-60-asset-uploads-server-validates-bo-14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Server validates.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Both the extension and the mime must be in the allowlist for the chosen type. Mismatches reject the upload."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-server-writes-the-file-15": {
      "id": "b-60-asset-uploads-server-writes-the-file-15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Server writes the file.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Filename = a unique slug of the original filename + original extension. Media lands under the selected project root at "
        },
        {
          "insert": "Assets/Media/{type}/{slug}.{ext}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; fonts land under "
        },
        {
          "insert": "Assets/Fonts/{slug}.{ext}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-server-registers-the-c-16": {
      "id": "b-60-asset-uploads-server-registers-the-c-16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Server registers the container.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A new entry is written into "
        },
        {
          "insert": "ProjectSettings/registries/assets.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keyed by the slug. Media entries keep logical "
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " paths like "
        },
        {
          "insert": "/assets/{type}/{slug}.{ext}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; font entries use "
        },
        {
          "insert": "/fonts/{slug}.{ext}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and include default font metadata."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-the-slug-is-the-source-o-17": {
      "id": "b-60-asset-uploads-the-slug-is-the-source-o-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The slug is the source of identity. If an upload would collide with an existing container, the server appends a numeric suffix so both containers can coexist."
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-validation-rules-18": {
      "id": "b-60-asset-uploads-validation-rules-18",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Validation rules"
        }
      ],
      "children": []
    },
    "b-60-asset-uploads-rule-19-tbl": {
      "id": "b-60-asset-uploads-rule-19-tbl",
      "type": "structured-table",
      "props": {
        "columns": [
          "Rule",
          "Why"
        ],
        "rows": [
          [
            "Type must be one of the five",
            "Anything else isn't an uploadable file asset."
          ],
          [
            "Extension must match type's list",
            "Catches drag-into-wrong-bucket mistakes."
          ],
          [
            "Mime must match type's list",
            "Catches renamed-extension mistakes."
          ],
          [
            "Filename slug must be non-empty",
            [
              {
                "insert": "A file named "
              },
              {
                "insert": ".png",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " or "
              },
              {
                "insert": "___",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " has no usable identity."
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-60-asset-uploads-there-is-no-size-limit-a-20": {
      "id": "b-60-asset-uploads-there-is-no-size-limit-a-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no size limit and no batch upload in this surface: single file at a time."
        }
      ],
      "children": []
    },

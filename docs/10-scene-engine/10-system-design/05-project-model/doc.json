    "b-05-project-model-a-project-is-a-colle-2": {
      "id": "b-05-project-model-a-project-is-a-colle-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "project",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is a collection of scenes (pages) that ship together as one site. Each scene is a single-viewport page. Navigation events route between scenes the way clicking a link routes between pages on a normal website. The project manifest is intentionally thin: it ties scenes together and declares the shared stage, nothing more."
        }
      ],
      "children": []
    },

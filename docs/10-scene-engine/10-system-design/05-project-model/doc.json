    "b-05-project-model-code-5": {
      "id": "b-05-project-model-code-5",
      "type": "code",
      "props": {},
      "text": [
        {
          "insert": "workspace.catalog.json\n└── projects[]                ← project ids and root folders\n\ncodecaine-site/\n├── ProjectSettings/\n│   ├── project.json          ← project manifest\n│   └── registries/\n│       ├── assets.json\n│       └── modules.json\n├── Assets/\n│   ├── Scenes/\n│   │   ├── title/scene.json\n│   │   └── menu/scene.json\n│   ├── Media/\n│   │   ├── audio/\n│   │   ├── image/\n│   │   ├── video/\n│   │   └── glyph/\n│   ├── Modules/\n│   │   ├── components/\n│   │   └── effects/\n│   └── Fonts/\n├── Library/\n└── Builds/"
        }
      ],
      "children": []
    },
    "b-05-project-model-the-scene-engine-opens-p-6": {
      "id": "b-05-project-model-the-scene-engine-opens-p-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scene engine opens project roots from a file-backed workspace catalog. A project owns the scenes, registries, media, modules, and fonts needed to author and export it. Engine-owned files are renderer/editor primitives and APIs that interpret the project data."
        }
      ],
      "children": []
    },
    "b-05-project-model-the-local-catalog-file-i-7": {
      "id": "b-05-project-model-the-local-catalog-file-i-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The local catalog file is "
        },
        {
          "insert": "workspace.catalog.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " beside the scene-engine app, with "
        },
        {
          "insert": "SCENE_ENGINE_WORKSPACE_CATALOG",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " available for alternate locations. Relative project roots resolve relative to the catalog file, not the process working directory. "
        },
        {
          "insert": "workspace.catalog.example.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is committed. The local catalog is gitignored."
        }
      ],
      "children": []
    },

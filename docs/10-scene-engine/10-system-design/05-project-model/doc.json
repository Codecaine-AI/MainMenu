    "b-05-project-model-name-on-each-scene-ref-11": {
      "id": "b-05-project-model-name-on-each-scene-ref-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on each scene reference is optional. If absent, the dashboard falls back to the scene's own "
        },
        {
          "insert": "name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field, then to its "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ".\n"
        },
        {
          "insert": "gates",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on a scene reference is an optional scene id: the id of another scene that this scene gates (preloads before transitioning to). When present, boot renders this scene first, preloads the target scene's assets with progress reporting, then transitions to the target."
        }
      ],
      "children": []
    },

    "b-05-project-model-inside-a-scene-an-event-24": {
      "id": "b-05-project-model-inside-a-scene-an-event-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Inside a scene, an event with "
        },
        {
          "insert": "action: \"navigate\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "target: \"<scene-id>\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " navigates to another scene in the project. In the export bundle, the renderer registers "
        },
        {
          "insert": "window.MELEE_navigate(sceneId)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the click handler calls it. Page-mode exports perform real static-page navigation to "
        },
        {
          "insert": "<scene-id>/index.html",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Runtime scene re-rendering remains available as a fallback for single-page previews."
        }
      ],
      "children": []
    },
    "b-05-project-model-the-dev-environment-work-25": {
      "id": "b-05-project-model-the-dev-environment-work-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dev environment works the same way conceptually, but routing carries the active project in the query string: "
        },
        {
          "insert": "/scenes/<scene-id>?project=<project-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for preview and "
        },
        {
          "insert": "/editor?project=<project-id>&scene=<scene-id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for editing. The editor still views one scene at a time and disables runtime events so clicks select layers instead of navigating."
        }
      ],
      "children": []
    },
    "b-05-project-model-scene-gates-26": {

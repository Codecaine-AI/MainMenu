    "b-20-asset-registry-scenes-never-reference-f-2": {
      "id": "b-20-asset-registry-scenes-never-reference-f-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Scenes never reference files directly. They reference "
        },
        {
          "insert": "container IDs",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and the registry maps each ID to a "
        },
        {
          "insert": "{ type, file }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (or "
        },
        {
          "insert": "{ type, path }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") pair. This indirection is what lets a single file swap update every scene that uses it, lets the renderer dispatch by type, and lets the editor enumerate available material."
        }
      ],
      "children": []
    },

    "b-20-asset-registry-the-container-model-only-43": {
      "id": "b-20-asset-registry-the-container-model-only-43",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The container model only earns its keep when scenes can select containers without hard-coding file paths. Three surfaces participate:"
        }
      ],
      "children": []
    },
    "b-20-asset-registry-inspector-dropdown-44": {
      "id": "b-20-asset-registry-inspector-dropdown-44",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Inspector dropdown.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Selecting an asset-type layer in the editor surfaces project-local assets of that type. Picking one updates the scene to reference the selected container ID."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-upload-uploading-a-45": {
      "id": "b-20-asset-registry-upload-uploading-a-45",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Upload.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Uploading a file writes a project-local file and creates a registry entry with a unique slug. If the slug already exists, the new container receives a numeric suffix."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-registry-patch-endpoin-46": {
      "id": "b-20-asset-registry-registry-patch-endpoin-46",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Registry patch endpoint.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Direct maintenance calls can move an existing container's "
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pointer. The current editor dropdown does not use this endpoint for normal selection."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-normal-selection-touches-47": {
      "id": "b-20-asset-registry-normal-selection-touches-47",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Normal selection touches scene JSON because the layer points at a different container ID. Direct registry patching touches only the registry and affects every scene that still references that container."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-foreign-children-reuse-t-48": {
      "id": "b-20-asset-registry-foreign-children-reuse-t-48",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [

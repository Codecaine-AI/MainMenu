    "b-20-asset-registry-the-split-is-conceptual-9": {
      "id": "b-20-asset-registry-the-split-is-conceptual-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The split is conceptual, not just organizational. An "
        },
        {
          "insert": "asset",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is an external file a non-developer would recognize as something they could upload: a video clip, an image, an audio sample, an SVG glyph, or a font file. A "
        },
        {
          "insert": "module",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " is hand-authored project code, a CSS effect sheet or JS component, that is configured rather than uploaded."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-test-would-it-make-10": {
      "id": "b-20-asset-registry-the-test-would-it-make-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The test: "
        },
        {
          "insert": "would it make sense to drag this onto an upload page?",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " If yes, it's an asset."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-this-split-shapes-everyt-11": {
      "id": "b-20-asset-registry-this-split-shapes-everyt-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This split shapes everything downstream. The upload UI and inspector asset-selection dropdown are scoped to file assets; the add-layer dialog uses the merged registry so it can add both file assets and authored modules. For v1, authored Codecaine modules live in the Codecaine project workspace, not in a shared engine module library."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-container-model-12": {
      "id": "b-20-asset-registry-the-container-model-12",

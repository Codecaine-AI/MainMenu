    "b-20-asset-registry-when-a-scene-renders-ev-35": {
      "id": "b-20-asset-registry-when-a-scene-renders-ev-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When a scene renders, every layer's "
        },
        {
          "insert": "asset",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field is looked up in a single merged view of both manifests:"
        }
      ],
      "children": []
    },
    "b-20-asset-registry-both-registries-are-load-36": {
      "id": "b-20-asset-registry-both-registries-are-load-36",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Both registries are loaded in parallel and merged into one map."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-for-each-layer-lookup-r-37": {
      "id": "b-20-asset-registry-for-each-layer-lookup-r-37",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For each layer, lookup returns the merged entry or "
        },
        {
          "insert": "null",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-if-the-entry-is-missing-38": {
      "id": "b-20-asset-registry-if-the-entry-is-missing-38",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "If the entry is missing, the layer is skipped with a warning. Render does not throw."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-renderer-is-dispatch-39": {
      "id": "b-20-asset-registry-the-renderer-is-dispatch-39",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The renderer is dispatched by "
        },
        {
          "insert": "layer",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", but receives the registry entry so it can fetch the entry's "
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "path",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }

    "b-20-asset-registry-image-and-video-are-spli-33": {
      "id": "b-20-asset-registry-image-and-video-are-spli-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Image and video are split (rather than collapsed under "
        },
        {
          "insert": "media",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") so the upload UI can reject mismatched files and so the renderers can diverge later."
        }
      ],
      "children": []

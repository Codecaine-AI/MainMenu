        {
          "insert": "Assets/Media/{type}/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "Assets/Fonts/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and adds a registry entry keyed by the slugified filename. See "
        },

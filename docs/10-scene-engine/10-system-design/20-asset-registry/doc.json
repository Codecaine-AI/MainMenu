          "insert": "Assets/Fonts/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", add an entry to "
        },
        {
          "insert": "ProjectSettings/registries/assets.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and keep the entry's logical "
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " path in "
        },
        {
          "insert": "/assets/...",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "/fonts/...",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " form."
        }

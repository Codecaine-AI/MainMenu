    "b-20-asset-registry-a-registry-entry-is-a-13": {
      "id": "b-20-asset-registry-a-registry-entry-is-a-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A registry entry is a "
        },
        {
          "insert": "container",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": a typed slot that points at a file. Scene layers reference the container by ID. Swapping the file inside the container propagates to every scene that referenced it, no scene edits needed."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-ascii-14": {
      "id": "b-20-asset-registry-ascii-14",
      "type": "code",
      "props": {
        "language": "ascii"
      },
      "text": [
        {
          "insert": "┌───────────┐    references    ┌──────────────────────┐    points to    ┌─────────────────┐\n│  Scene    │─────────────────▶│  Container (registry) │────────────────▶│  File on disk    │\n│  Layer    │ \"asset\":\"bg-vid\" │  id: \"bg-vid\"         │  file:          │  /assets/video/  │\n│           │                  │  type: \"video\"        │  \"/assets/      │  test-fire-3.mp4 │\n└───────────┘                  └──────────────────────┘  video/test...\"  └─────────────────┘"
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-model-is-intentional-15": {
      "id": "b-20-asset-registry-the-model-is-intentional-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The model is intentionally Unity-flavored: scenes describe "
        },
        {
          "insert": "intent",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " (which container, what kind, how positioned); the container holds "
        },
        {
          "insert": "identity",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " (this is the bg-video, of type video); the file is just the current bytes for that identity."
        }
      ],
      "children": []

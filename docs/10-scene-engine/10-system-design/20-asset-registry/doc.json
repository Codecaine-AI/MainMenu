    "b-20-asset-registry-if-the-same-id-appears-i-40": {
      "id": "b-20-asset-registry-if-the-same-id-appears-i-40",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If the same ID appears in both manifests, the module entry overrides the asset entry and a warning is logged. This is treated as a misconfiguration rather than a normal flow."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-the-layer-s-type-and-t-41": {
      "id": "b-20-asset-registry-the-layer-s-type-and-t-41",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The layer's "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the registry entry's "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are "
        },
        {
          "insert": "expected",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " to match in well-formed scenes. Misaligned types result in a fetch returning unusable content rather than a clean error."
        }

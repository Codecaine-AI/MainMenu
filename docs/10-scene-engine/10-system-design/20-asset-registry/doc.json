        {
          "insert": ". Content lives next to the component (e.g. "
        },
        {
          "insert": "press-start-data.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " next to "
        },
        {
          "insert": "press-start.js",
          "attributes": {
            "code": true
          }

        "ordered": false
      },
      "text": [
        {
          "insert": "Per-scene placement",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". That's a layer's job, not a container's."
        }
      ],
      "children": []
    },
    "b-20-asset-registry-per-scene-properties-55": {
      "id": "b-20-asset-registry-per-scene-properties-55",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Per-scene properties",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", the registry holds what the container "
        },
        {
          "insert": "is",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": ", not how a scene uses it. Blend, opacity, scale, hue all live on the layer."

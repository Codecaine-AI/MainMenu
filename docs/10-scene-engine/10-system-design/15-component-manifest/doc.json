    "b-15-component-manifest-effects-and-components-s-2": {
      "id": "b-15-component-manifest-effects-and-components-s-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Effects and components ship a "
        },
        {
          "insert": "manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " next to their code. The manifest declares module-level metadata: name, type, sizing hint, and, for effects, the editable property descriptors that drive the inspector."
        }
      ],
      "children": []
    },
    "b-15-component-manifest-for-components-and-b-3": {
      "id": "b-15-component-manifest-for-components-and-b-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For "
        },
        {
          "insert": "components",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " and built-in layer types (media, glyph-group, audio), property editing is driven by the "
        },
        {
          "insert": "property schema convention",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-scene-engine/10-system-design/16-property-schema",
              "label": "property schema convention"
            }
          }
        },
        {
          "insert": ", not the manifest. The manifest is still required for name, type, and sizing metadata, but component property fields come from the schema exported by the component's code module."
        }
      ],
      "children": []
    },
    "b-15-component-manifest-for-effects-the-man-4": {
      "id": "b-15-component-manifest-for-effects-the-man-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For "
        },
        {
          "insert": "effects",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", the manifest remains the authoritative source of property descriptors. Effects are pure CSS and have no code module to attach a schema to."
        }
      ],
      "children": []
    },
    "b-15-component-manifest-this-is-the-contract-tha-5": {
      "id": "b-15-component-manifest-this-is-the-contract-tha-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is the contract that makes the system open for extension: a new contributor can drop in a CSS file (effect) or JS file (component) plus a manifest, and it just works in both the editor and the runtime."
        }
      ],
      "children": []
    },

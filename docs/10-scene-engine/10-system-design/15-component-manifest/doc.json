    "b-15-component-manifest-projectsettings-registr-9": {
      "id": "b-15-component-manifest-projectsettings-registr-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "ProjectSettings/registries/modules.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the index. Each entry declares "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the logical "
        },
        {
          "insert": "path",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the module's primary file, such as "
        },
        {
          "insert": "/modules/components/press-start/press-start.js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The renderer reads the manifest from the module's directory through the project file routes and merges it into the registry entry at load time."
        }
      ],
      "children": []
    },

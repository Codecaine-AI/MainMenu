    "b-30-rendering-pipeline-turning-a-scene-into-ren-2": {
      "id": "b-30-rendering-pipeline-turning-a-scene-into-ren-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Turning a scene into rendered DOM is a small, predictable pipeline: load the registry, walk "
        },
        {
          "insert": "scene.objects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", dispatch each one to a per-type renderer, append the returned element, then apply the universal transform/appearance styling. The only meaningful complexity lives inside the "
        },
        {
          "insert": "glyph-group",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " renderer, which mounts editable slots into the SVG."
        }
      ],
      "children": []
    },
    "b-30-rendering-pipeline-the-renderer-is-invoked-3": {
      "id": "b-30-rendering-pipeline-the-renderer-is-invoked-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The renderer is invoked twice in the editor: once to mount the scene and again on every store change to update it in place, so each step is reconciliation-aware."

{
  "id": "title",
  "name": "Title Screen",
  "stage": {
    "width": 1440,
    "height": 1080
  },
  "objects": [
    {
      "id": "bg-video",
      "type": "video",
      "asset": "bg-video",
      "visible": false,
      "transform": { "mode": "fill" },
      "appearance": {
        "fit": "fill",
        "blend": "normal",
        "opacity": 0.75
      }
    },
    {
      "id": "codecaine-logo",
      "type": "glyph-group",
      "asset": "codecaine-logo",
      "transform": {
        "x": 50,
        "y": 20,
        "width": 18,
        "height": "auto",
        "anchor": "center"
      },
      "properties": {
        "shimmer": true
      },
      "slots": [
        {
          "id": "in-text-fire",
          "type": "video-fill",
          "asset": "in-text-fire",
          "appearance": {
            "blend": "screen",
            "opacity": 0.85,
            "fit": "cover"
          }
        }
      ]
    },
    {
      "id": "press-start",
      "type": "component",
      "asset": "press-start",
      "transform": {
        "x": 50,
        "y": 75,
        "width": 30,
        "height": "auto",
        "anchor": "center"
      },
      "properties": {
        "text": "PRESS  START",
        "blink-rate": 1.1
      },
      "events": [
        { "trigger": "click", "action": "navigate", "target": "menu" },
        { "trigger": "click", "action": "play-audio", "target": "start-cue" }
      ]
    },
    {
      "id": "start-cue",
      "type": "audio",
      "asset": "start-cue",
      "visible": false,
      "transform": { "mode": "fill" },
      "properties": {
        "volume": 0.6,
        "loop": false
      },
      "events": [
        { "trigger": "load", "action": "autoplay" }
      ]
    },
    {
      "id": "crt",
      "type": "effect",
      "asset": "crt-overlay",
      "visible": false,
      "transform": { "mode": "fill" },
      "appearance": { "opacity": 1 }
    }
  ]
}

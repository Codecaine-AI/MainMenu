{
  "name": "Menu Shield",
  "type": "component",
  "sizing": "fill",
  "dependencies": {
    "publicFiles": [
      "/modules/components/menu-shield/menu-shield.css",
      "/modules/components/menu-shield/menu-shield-frame.svg"
    ]
  },
  "properties": {
    "top-text": { "type": "string", "default": "Main Menu" },
    "bottom-text": { "type": "string", "default": "Solo Smash!" },
    "border-color": { "type": "color", "default": "#3158e8" },
    "border-opacity": { "type": "number", "default": 0.96, "min": 0, "max": 1, "step": 0.01 },
    "fill-opacity": { "type": "number", "default": 0.3, "min": 0, "max": 1, "step": 0.01 },
    "top-text-color": { "type": "color", "default": "#a7a9b7" },
    "top-text-opacity": { "type": "number", "default": 1, "min": 0, "max": 1, "step": 0.01 },
    "top-text-glow-size": { "type": "number", "default": 0, "min": 0, "max": 40, "step": 0.5 },
    "top-text-glow-opacity": { "type": "number", "default": 0, "min": 0, "max": 1, "step": 0.01 },
    "bottom-text-color": { "type": "color", "default": "#e4e7ff" },
    "top-box-x": { "type": "number", "default": 176, "min": 0, "max": 1440, "step": 1 },
    "top-box-y": { "type": "number", "default": 88, "min": 0, "max": 1080, "step": 1 },
    "top-box-width": { "type": "number", "default": 445, "min": 40, "max": 1440, "step": 1 },
    "top-box-height": { "type": "number", "default": 76, "min": 24, "max": 220, "step": 1 },
    "bottom-center-in-box": { "type": "boolean", "default": true },
    "debug-text-boxes": { "type": "boolean", "default": false },
    "button-border-color": { "type": "color", "default": "#eef1ff" },
    "button-fill-color": { "type": "color", "default": "#03040a" }
  }
}

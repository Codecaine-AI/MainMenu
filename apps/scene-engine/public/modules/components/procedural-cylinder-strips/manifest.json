{
  "name": "Procedural Cylinder Strips",
  "type": "component",
  "properties": {
    "animate": { "type": "boolean", "default": true },
    "palette-mode": { "type": "enum", "default": "melee-spectrum", "options": ["melee-spectrum", "hue-wheel", "rgb-stops"] },
    "color-start": { "type": "color", "default": "#120E4C" },
    "color-mid": { "type": "color", "default": "#24106A" },
    "color-end": { "type": "color", "default": "#561735" },
    "color-magenta": { "type": "color", "default": "#6D1A55" },
    "color-cycle": { "type": "number", "default": 1.25, "min": 1, "max": 20, "step": 0.05 },
    "color-offset": { "type": "number", "default": 0, "min": -4, "max": 4, "step": 0.01 },
    "color-speed": { "type": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.001 },
    "color-bias": { "type": "number", "default": 0.9, "min": 0.1, "max": 4, "step": 0.05 },
    "wheel-hue-shift": { "type": "number", "default": 226, "min": 0, "max": 360, "step": 1 },
    "wheel-saturation": { "type": "number", "default": 0.82, "min": 0, "max": 1.2, "step": 0.01 },
    "wheel-lightness": { "type": "number", "default": 0.53, "min": 0.08, "max": 0.86, "step": 0.01 },
    "wheel-mint-lift": { "type": "number", "default": 0.16, "min": -0.2, "max": 0.35, "step": 0.01 },
    "wheel-softness": { "type": "number", "default": 0.58, "min": 0, "max": 1, "step": 0.01 },
    "wheel-contrast": { "type": "number", "default": 0.92, "min": 0, "max": 1.5, "step": 0.01 },
    "texture-angle": { "type": "number", "default": -18, "min": -180, "max": 180, "step": 1 },
    "texture-speed": { "type": "number", "default": 0, "min": -1, "max": 1, "step": 0.001 },
    "texture-scale": { "type": "number", "default": 1, "min": 0.2, "max": 4, "step": 0.05 },
    "texture-resolution": { "type": "number", "default": 0.55, "min": 0.2, "max": 1, "step": 0.05 },
    "strip-count": { "type": "number", "default": 40, "min": 4, "max": 80, "step": 1 },
    "strip-width": { "type": "number", "default": 0.86, "min": 0.05, "max": 1.5, "step": 0.01 },
    "curve-steps": { "type": "number", "default": 7, "min": 3, "max": 18, "step": 1 },
    "opacity": { "type": "number", "default": 0.26, "min": 0, "max": 1, "step": 0.01 },
    "minimum-open": { "type": "number", "default": 0.08, "min": 0.005, "max": 1, "step": 0.005 },
    "rotation-offset": { "type": "number", "default": 0, "min": -180, "max": 180, "step": 1 },
    "closed-hold-seconds": { "type": "number", "default": 0.12, "min": 0, "max": 10, "step": 0.01 },
    "transition-seconds": { "type": "number", "default": 0.45, "min": 0.02, "max": 10, "step": 0.01 },
    "open-hold-seconds": { "type": "number", "default": 0.12, "min": 0, "max": 10, "step": 0.01 },
    "gate-offset-seconds": { "type": "number", "default": 0, "min": -10, "max": 10, "step": 0.01 },
    "center-x": { "type": "number", "default": 0.5, "min": -0.5, "max": 1.5, "step": 0.01 },
    "center-y": { "type": "number", "default": 0.52, "min": -0.5, "max": 1.5, "step": 0.01 },
    "radius": { "type": "number", "default": 1.5, "min": 0.05, "max": 8, "step": 0.01 },
    "inner-radius": { "type": "number", "default": 0.02, "min": 0, "max": 4, "step": 0.01 },
    "outer-radius": { "type": "number", "default": 1.04, "min": 0.05, "max": 6, "step": 0.01 },
    "depth-curve": { "type": "number", "default": 1.18, "min": 0.2, "max": 4, "step": 0.01 },
    "target-fps": { "type": "number", "default": 24, "min": 1, "max": 60, "step": 1 },
    "dpr-cap": { "type": "number", "default": 1, "min": 1, "max": 2, "step": 0.05 }
  }
}

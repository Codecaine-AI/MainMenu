{
  "name": "Main Menu System",
  "type": "component",
  "sizing": "fill",
  "dependencies": {
    "modules": ["menu-items", "menu-shield", "side-menu"],
    "publicFiles": [
      "/modules/components/main-menu-system/menu-config.json",
      "/modules/components/menu-items/menu-items.css",
      "/modules/components/menu-items/menu-item.svg",
      "/modules/components/menu-shield/menu-shield.css",
      "/modules/components/menu-shield/menu-shield-frame.svg",
      "/modules/components/side-menu/side-menu.css",
      "/modules/components/side-menu/side-menu.svg"
    ]
  },
  "properties": {
    "config": {
      "type": "string",
      "default": "/modules/components/main-menu-system/menu-config.json"
    },
    "initial-menu": {
      "type": "string",
      "default": "main"
    },
    "enable-keyboard": {
      "type": "boolean",
      "default": true
    },
    "enable-gamepad": {
      "type": "boolean",
      "default": true
    },
    "transition-ms": {
      "type": "number",
      "default": 300,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "theme-transition-ms": {
      "type": "number",
      "default": 220,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "selection-target-fade-ms": {
      "type": "number",
      "default": 140,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "menu-item-color-transition-ms": {
      "type": "number",
      "default": 140,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "caption-transition-ms": {
      "type": "number",
      "default": 220,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "menu-motion-easing": {
      "type": "string",
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "menu-orbit-radius": {
      "type": "number",
      "default": 360,
      "min": 120,
      "max": 1800,
      "step": 5
    },
    "menu-orbit-angle": {
      "type": "number",
      "default": 18,
      "min": 0,
      "max": 180,
      "step": 1
    },
    "menu-orbit-debug": {
      "type": "boolean",
      "default": false
    },
    "menu-orbit-center-x": {
      "type": "number",
      "default": 720,
      "min": -1440,
      "max": 2880,
      "step": 1
    },
    "menu-orbit-center-y": {
      "type": "number",
      "default": 540,
      "min": -1080,
      "max": 2160,
      "step": 1
    },
    "menu-orbit-debug-opacity": {
      "type": "number",
      "default": 0.86,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "title-prism-ms": {
      "type": "number",
      "default": 340,
      "min": 0,
      "max": 2000,
      "step": 10
    },
    "title-prism-depth": {
      "type": "number",
      "default": 66,
      "min": 0,
      "max": 220,
      "step": 1
    },
    "title-prism-lift": {
      "type": "number",
      "default": 24,
      "min": 0,
      "max": 160,
      "step": 1
    },
    "title-prism-perspective": {
      "type": "number",
      "default": 620,
      "min": 220,
      "max": 1600,
      "step": 10
    },
    "title-prism-angle": {
      "type": "number",
      "default": 120,
      "min": 60,
      "max": 150,
      "step": 1
    },
    "ui-navigation-sound": {
      "type": "string",
      "assetType": "audio",
      "default": "ui-navigation"
    },
    "ui-forward-sound": {
      "type": "string",
      "assetType": "audio",
      "default": "ui-forward"
    },
    "ui-back-sound": {
      "type": "string",
      "assetType": "audio",
      "default": "ui-back"
    },
    "ui-navigation-volume": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "ui-forward-volume": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "ui-back-volume": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "back-target": {
      "type": "string",
      "default": "title"
    }
  }
}

{
  "name": "Procedural Cylinder",
  "type": "component",
  "properties": {
    "animate": { "type": "boolean", "default": true },
    "cylinder-color": { "type": "color", "default": "#33709e" },
    "rotation-speed": { "type": "number", "default": 0.08, "min": -0.25, "max": 0.25, "step": 0.001 },
    "pulse-speed": { "type": "number", "default": 0.06, "min": -0.2, "max": 0.2, "step": 0.001 },
    "pulse-width": { "type": "number", "default": 0.1, "min": 0.01, "max": 0.5, "step": 0.01 },
    "pulse-trail": { "type": "number", "default": 0.18, "min": 0, "max": 0.6, "step": 0.01 },
    "lines": { "type": "number", "default": 56, "min": 4, "max": 160, "step": 1 },
    "rings": { "type": "number", "default": 10, "min": 0, "max": 48, "step": 1 },
    "line-width": { "type": "number", "default": 1.25, "min": 0.1, "max": 8, "step": 0.05 },
    "radius": { "type": "number", "default": 0.5, "min": 0.01, "max": 2, "step": 0.01 },
    "cylinder-height": { "type": "number", "default": 1.4, "min": 0.05, "max": 10, "step": 0.05 },
    "camera-gap": { "type": "number", "default": 0.08, "min": 0, "max": 0.8, "step": 0.01 },
    "position-x": { "type": "number", "default": 0, "min": -2, "max": 2, "step": 0.01 },
    "position-y": { "type": "number", "default": 0, "min": -2, "max": 2, "step": 0.01 },
    "position-z": { "type": "number", "default": 0, "min": -10, "max": 10, "step": 0.05 },
    "center-x": { "type": "number", "default": 0.5, "min": -0.5, "max": 1.5, "step": 0.01 },
    "center-y": { "type": "number", "default": 0.5, "min": -0.5, "max": 1.5, "step": 0.01 },
    "tilt-x": { "type": "number", "default": 0, "min": -180, "max": 180, "step": 1 },
    "tilt-y": { "type": "number", "default": 0, "min": -180, "max": 180, "step": 1 },
    "tilt-z": { "type": "number", "default": 0, "min": -180, "max": 180, "step": 1 },
    "camera-distance": { "type": "number", "default": 1200, "min": 100, "max": 8000, "step": 10 },
    "near-clip": { "type": "number", "default": 8, "min": 1, "max": 2000, "step": 1 },
    "max-perspective": { "type": "number", "default": 4.8, "min": 1, "max": 20, "step": 0.1 }
  }
}
